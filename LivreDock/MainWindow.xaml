<Window x:Class="LivreDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LivreDock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Fundo do dock: cantos arredondados, translucido (acrylic entra atras em runtime) -->
    <Border x:Name="DockRoot"
            CornerRadius="18"
            Margin="12"
            Padding="10,8"
            Background="#80202124"
            BorderBrush="#30FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="0" Opacity="0.5" />
        </Border.Effect>

        <StackPanel x:Name="Items" Orientation="Horizontal" VerticalAlignment="Bottom" />
    </Border>
</Window>
